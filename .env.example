# 복사해서 .env.local 로 저장하고 값을 채운다. 이 파일에는 값이 아니라 변수 이름만 둔다.

# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저에 노출 금지. 시드·업로드 처리에만 사용
SUPABASE_SERVICE_ROLE_KEY=

# Supabase 대시보드 → Project Settings → Database → Connection string (URI)
# 마이그레이션·시드 스크립트(npm run db:migrate / db:seed)에서만 사용. Vercel에는 등록하지 않는다
DATABASE_URL=
